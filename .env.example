# Dashboard password (required for dashboard and management API)
DASHBOARD_PASSWORD=change-me-locally
# Webhook secret, not the Razorpay API key secret; use Test Mode during development
RAZORPAY_WEBHOOK_SECRET=replace-with-test-webhook-secret
# Optional rotation overlap, comma-separated
# RAZORPAY_WEBHOOK_SECRETS=current-secret,previous-secret
# Keep remote replay disabled by default
REPLAY_ALLOW_REMOTE=false
